# Downloaded bytes + derived text — fetch your own copy with the loader; respect each source's
# license. These hold copyrighted content under mixed licenses and must NEVER be committed.
# raw/ = original bytes (sha256 anchor) · text/ = verbatim extraction · corpus/ = cleaned output
raw/
text/
corpus/
# Immutable payload versions of PostgreSQL-staged runs (ADR 0001 stage 4 step 3) — same bytes, same rule
artifacts/

# Agent scratch space — one-off scripts & notes stay local (see workspace/README.md)
workspace/*
!workspace/README.md

# Daily-dig / marathon run logs (scripts/dig.sh, scripts/marathon.sh)
logs/

# Python
__pycache__/
*.py[cod]
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/
